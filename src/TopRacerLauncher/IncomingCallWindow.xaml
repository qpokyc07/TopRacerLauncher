<Window x:Class="TopRacerLauncher.IncomingCallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Входящий звонок"
        Width="410" Height="212"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI">
    <Border CornerRadius="18" Background="#F20B0D12" Padding="22,18"
            BorderBrush="#40FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="34" ShadowDepth="6" Opacity="0.75"/>
        </Border.Effect>

        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Width="46" Height="46" CornerRadius="23" Margin="0,0,14,0"
                        Background="{DynamicResource AccentBrush}">
                    <Path Data="M6.62,10.79c1.44,2.83 3.76,5.14 6.59,6.59l2.2,-2.2c0.27,-0.27 0.67,-0.36 1.02,-0.24c1.12,0.37 2.33,0.57 3.57,0.57c0.55,0 1,0.45 1,1V20c0,0.55 -0.45,1 -1,1c-9.39,0 -17,-7.61 -17,-17c0,-0.55 0.45,-1 1,-1h3.5c0.55,0 1,0.45 1,1c0,1.25 0.2,2.45 0.57,3.57c0.11,0.35 0.03,0.74 -0.25,1.02l-2.2,2.2z"
                          Fill="White" Width="21" Height="21" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ВХОДЯЩИЙ ЗВОНОК" FontSize="10.5" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="CallerText" Text="" FontSize="16.5" FontWeight="Bold"
                               Foreground="White" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                               MaxWidth="290" HorizontalAlignment="Left"/>
                    <TextBlock Text="приглашает в голосовой чат" FontSize="11.5"
                               Foreground="#99FFFFFF" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="DeclineButton" Content="Отклонить" Height="38" Padding="18,0"
                        FontSize="13" Style="{StaticResource BaseButton}" Click="Decline_Click"/>
                <Button x:Name="AcceptButton" Content="Присоединиться" Height="38" Padding="20,0"
                        Margin="8,0,0,0" FontSize="13" Style="{StaticResource PrimaryButton}"
                        Click="Accept_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
