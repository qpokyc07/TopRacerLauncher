<Window x:Class="TopRacerLauncher.LegalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TopRacerLauncher — документы"
        Width="720" Height="620" MinWidth="560" MinHeight="420"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgWindowBrush}"
        FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock x:Name="HeaderText" Text="Документы" FontWeight="Bold" FontSize="15"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0"/>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                        Width="38" Height="34" Style="{StaticResource BaseButton}"
                        Click="Close_Click" Content="&#x2715;" FontSize="12"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="0" Background="{DynamicResource BgPanelBrush}"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="18,12,18,6" Panel.ZIndex="1">
            <Button x:Name="PrivacyTab" Content="Политика конфиденциальности" Height="32" Padding="14,0"
                    FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0"
                    Style="{StaticResource BaseButton}" Click="Privacy_Click"/>
            <Button x:Name="TermsTab" Content="Пользовательское соглашение" Height="32" Padding="14,0"
                    FontSize="12" FontWeight="SemiBold"
                    Style="{StaticResource BaseButton}" Click="Terms_Click"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0" Panel.ZIndex="1">
            <TextBlock x:Name="BodyText" Text="" FontSize="13" LineHeight="21"
                       Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                       Margin="22,8,22,16"/>
        </ScrollViewer>

        <Border Grid.Row="3" Background="{DynamicResource BgPanelBrush}" Padding="20,12" Panel.ZIndex="1"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Button Content="Понятно" Height="38" Padding="24,0" FontSize="13.5"
                    HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButton}" Click="Close_Click" IsDefault="True"/>
        </Border>
    </Grid>
</Window>