<Window x:Class="TopRacerLauncher.VoiceOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TopRacerLauncher — звонок"
        SizeToContent="Height" Width="248"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        FontFamily="Segoe UI" IsHitTestVisible="False">
    <Border CornerRadius="14" Background="#D90A0B11" BorderBrush="#38FFFFFF" BorderThickness="1"
            Padding="10,9,10,9">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="4" Opacity="0.5"/>
        </Border.Effect>

        <StackPanel>
            <Grid Margin="2,0,2,6">
                <TextBlock x:Name="HeaderText" Text="ЗВОНОК" FontSize="9.5" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="CountText" Text="" FontSize="9.5" HorizontalAlignment="Right"
                           Foreground="#8CFFFFFF" VerticalAlignment="Center"/>
            </Grid>

            <StackPanel x:Name="RowsPanel"/>
        </StackPanel>
    </Border>
</Window>
