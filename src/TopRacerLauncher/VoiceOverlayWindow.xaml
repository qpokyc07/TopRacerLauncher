<Window x:Class="TopRacerLauncher.VoiceOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TopRacerLauncher — звонок"
        SizeToContent="Height" Width="196"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        FontFamily="Segoe UI" IsHitTestVisible="False">
    <Border CornerRadius="12" Background="#A60A0B11" BorderBrush="#24FFFFFF" BorderThickness="1"
            Padding="8,7,8,7">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="3" Opacity="0.35"/>
        </Border.Effect>

        <StackPanel>
            <Grid Margin="2,0,2,6">
                <TextBlock x:Name="HeaderText" Text="ЗВОНОК" FontSize="9.5" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="CountText" Text="" FontSize="9.5" HorizontalAlignment="Right"
                           Foreground="#8CFFFFFF" VerticalAlignment="Center"/>
            </Grid>

            <StackPanel x:Name="RowsPanel"/>
        </StackPanel>
    </Border>
</Window>
