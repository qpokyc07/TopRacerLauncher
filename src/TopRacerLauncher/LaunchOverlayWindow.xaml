<Window x:Class="TopRacerLauncher.LaunchOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TopRacerLauncher"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        FontFamily="Segoe UI" Cursor="Hand" MouseLeftButtonUp="Close_Click">
    <Border CornerRadius="22" Background="#F2121218" BorderBrush="#40FFFFFF" BorderThickness="1"
            Padding="54,38">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="42" ShadowDepth="8" Opacity="0.65"/>
        </Border.Effect>

        <StackPanel HorizontalAlignment="Center">
            <!-- Кольцо загрузки: дуга вращается по кругу -->
            <Grid Width="72" Height="72" HorizontalAlignment="Center">
                <Ellipse Stroke="#2EFFFFFF" StrokeThickness="5"/>
                <Path Data="M 36,3 A 33,33 0 0 1 69,36"
                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                    </Path.RenderTransform>
                    <Path.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="360" Duration="0:0:0.9"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Path.Triggers>
                </Path>
            </Grid>

            <TextBlock x:Name="TitleText" Text="Игра запускается" FontSize="26" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" Margin="0,18,0,0"/>
            <TextBlock x:Name="HintText" Text="ждите…" FontSize="18" Foreground="#B9B9C4"
                       HorizontalAlignment="Center" Margin="0,9,0,0"/>

            <!-- Управление: мини-клавиатура с нужными клавишами -->
            <StackPanel x:Name="ControlsPanel" HorizontalAlignment="Center" Margin="0,24,0,0"
                        Visibility="Collapsed">
                <Border Height="1" Background="#26FFFFFF" Margin="0,0,0,18"/>

                <TextBlock Text="Управление" FontSize="12" FontWeight="Bold"
                           Foreground="#8E8E9E" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                <StackPanel x:Name="ControlsRows" HorizontalAlignment="Center"/>

                <TextBlock x:Name="ControlsNoteText" Text="" FontSize="12.5" Foreground="#B9B9C4"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                           HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
