<Window x:Class="TopRacerLauncher.LaunchOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TopRacerLauncher"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        FontFamily="Segoe UI" Cursor="Hand" MouseLeftButtonUp="Close_Click">
    <Border CornerRadius="16" Background="#F2121218" BorderBrush="#40FFFFFF" BorderThickness="1"
            Padding="34,24">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="6" Opacity="0.6"/>
        </Border.Effect>
        <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="&#x1F3AE;" FontSize="30" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TitleText" Text="Игра запускается" FontSize="17" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <TextBlock x:Name="HintText" Text="ждите…" FontSize="12.5" Foreground="#B9B9C4"
                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>
    </Border>
</Window>
