<Window x:Class="TopRacerLauncher.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TopRacerLauncher"
        Width="470" Height="620"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgWindowBrush}"
        FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="0"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                        Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                    <TextBlock x:Name="AvatarText" Text="?" FontSize="14" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock x:Name="HeaderText" Text="Чат" FontWeight="Bold" FontSize="14"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="SubText" Text="в сети" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="36" Height="32" Style="{StaticResource CaptionButton}"
                        Click="Close_Click" Content="&#x2715;" FontSize="11"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <!-- Лог -->
        <ScrollViewer Grid.Row="1" x:Name="LogScroll" VerticalScrollBarVisibility="Auto"
                      Margin="14,12,14,0">
            <StackPanel x:Name="LogPanel"/>
        </ScrollViewer>

        <!-- Эмодзи и стикеры -->
        <Border Grid.Row="2" x:Name="EmojiPanel" Visibility="Collapsed"
                Background="{DynamicResource BgPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="0,1,0,0" Padding="10,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button x:Name="EmojiTab" Content="Эмодзи" Height="28" Padding="14,0" FontSize="11.5"
                            Style="{StaticResource BaseButton}" Click="EmojiTab_Click"/>
                    <Button x:Name="StickerTab" Content="Стикеры" Height="28" Padding="14,0" FontSize="11.5"
                            Margin="6,0,0,0" Style="{StaticResource BaseButton}" Click="StickerTab_Click"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="140">
                    <UniformGrid x:Name="EmojiGrid" Columns="8" HorizontalAlignment="Stretch"/>
                </ScrollViewer>

                <ScrollViewer x:Name="StickerScroll" VerticalScrollBarVisibility="Auto" MaxHeight="140"
                              Visibility="Collapsed">
                    <UniformGrid x:Name="StickerGrid" Columns="4" HorizontalAlignment="Stretch"/>
                </ScrollViewer>
            </StackPanel>
        </Border>
        <!-- Ввод -->
        <Grid Grid.Row="3" Margin="14,10,14,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="EmojiButton" Width="40" Height="40" Padding="0"
                    Margin="0,0,8,0" Style="{StaticResource BaseButton}"
                    Click="Emoji_Click" ToolTip="Эмодзи и стикеры">
                <Grid Width="22" Height="22">
                    <Ellipse Stroke="{StaticResource TextBrush}" StrokeThickness="1.6"/>
                    <Ellipse Width="3.4" Height="3.4" Fill="{StaticResource TextBrush}"
                             HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5.6,7.4,0,0"/>
                    <Ellipse Width="3.4" Height="3.4" Fill="{StaticResource TextBrush}"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7.4,5.6,0"/>
                    <Path Data="M 5.4,12.6 A 6,5.4 0 0 0 16.6,12.6"
                          Stroke="{StaticResource TextBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Grid>
            </Button>
            <TextBox x:Name="MessageBox" Grid.Column="1" Style="{StaticResource BaseTextBox}"
                     Height="40" MaxLength="400" KeyDown="MessageBox_KeyDown"/>

            <Button Grid.Column="2" Content="Отправить" Height="40" Padding="16,0" Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButton}" Click="Send_Click"/>
        </Grid>
    </Grid>
</Window>
