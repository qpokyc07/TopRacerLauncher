<Window x:Class="TopRacerLauncher.ControlsOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TopRacerLauncher — управление"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        FontFamily="Segoe UI" IsHitTestVisible="False">
    <Border x:Name="Shell" CornerRadius="16" Background="#C70A0B11" BorderBrush="#33FFFFFF" BorderThickness="1"
            Padding="16,12,16,14">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="26" ShadowDepth="5" Opacity="0.55"/>
        </Border.Effect>

        <StackPanel>
            <Grid Margin="2,0,2,10">
                <TextBlock x:Name="HeaderText" Text="УПРАВЛЕНИЕ" FontSize="10" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="GameText" Text="" FontSize="10" HorizontalAlignment="Right"
                           Foreground="#7AFFFFFF" VerticalAlignment="Center"/>
            </Grid>

            <StackPanel x:Name="KeyboardPanel"/>

            <Grid Margin="0,10,0,0">
                <TextBlock Text="" FontSize="10" Foreground="#66FFFFFF"/>
                <TextBlock x:Name="NoteText" Text="" FontSize="10.5" HorizontalAlignment="Right"
                           Foreground="#8CFFFFFF"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
