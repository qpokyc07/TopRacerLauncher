<Window x:Class="TopRacerLauncher.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TopRacerLauncher"
        Title="TopRacerLauncher"
        Width="480" Height="470"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgWindowBrush}"
        FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="0"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Grid Grid.Row="0" Background="{DynamicResource BgPanelBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0">
                <TextBlock Text="TopRacer" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Launcher" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource AccentBrush}" Margin="4,0,0,0"/>
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                    Width="38" Height="34" Style="{StaticResource BaseButton}"
                    Click="Cancel_Click" Content="&#x2715;" FontSize="12" WindowChrome.IsHitTestVisibleInChrome="True"/>
        </Grid>

        <!-- Тело -->
        <StackPanel Grid.Row="1" Margin="32,24,32,24">
            <Border Width="56" Height="56" CornerRadius="28" Background="#2A3F5F"
                    HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="&#x1F512;" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock x:Name="TitleText" Text="Создание пароля администратора"
                       Style="{StaticResource H1Text}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock x:Name="SubtitleText"
                       Text="Лаунчер — закрытая система. Пароль понадобится для входа&#x0a;и для админ-меню (Ctrl+1)."
                       Style="{StaticResource SecondaryText}" HorizontalAlignment="Center"
                       TextAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap"/>

            <TextBlock Text="Новый пароль" Style="{StaticResource H2Text}" Margin="0,26,0,8"/>
            <local:MaskedInput x:Name="PasswordInput1" Style="{StaticResource BaseTextBox}" Height="40"
                          MaxLength="64" TextChanged="Password_Changed"/>

            <TextBlock Text="Повторите пароль" Style="{StaticResource H2Text}" Margin="0,16,0,8"/>
            <local:MaskedInput x:Name="PasswordInput2" Style="{StaticResource BaseTextBox}" Height="40"
                          MaxLength="64" KeyDown="Password2_KeyDown"/>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="13"
                       Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

            <TextBlock Text="Минимум 4 символа. Не забудьте пароль — без него&#x0a;доступ к лаунчеру будет закрыт."
                       Style="{StaticResource SecondaryText}" Margin="0,14,0,0" TextWrapping="Wrap"/>

            <Button x:Name="SubmitButton" Content="Создать пароль" Style="{StaticResource PrimaryButton}"
                    Height="44" FontSize="14" Margin="0,24,0,0" Click="Submit_Click" IsDefault="True"/>
            <Button Content="Отмена" Style="{StaticResource BaseButton}"
                    Height="40" Margin="0,10,0,0" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
