<Window x:Class="TopRacerLauncher.AddGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TopRacerLauncher — Добавление игры"
        Width="600" Height="580" MinWidth="520" MinHeight="480"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgWindowBrush}"
        FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="0"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock x:Name="HeaderText" Text="Добавить игру" FontWeight="Bold" FontSize="15"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0"/>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                        Width="38" Height="34" Style="{StaticResource BaseButton}"
                        Click="Cancel_Click" Content="&#x2715;" FontSize="12"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <!-- Форма: прокручивается, кнопки внизу всегда на месте -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel Margin="26,20,22,10">
                <TextBlock Text="Название" Style="{StaticResource H2Text}" Margin="0,0,0,8"/>
                <TextBox x:Name="TitleBox" Style="{StaticResource BaseTextBox}" Height="40"
                         MaxLength="80" FontSize="14"/>

                <TextBlock Text="Файл игры (.exe или .lnk)" Style="{StaticResource H2Text}" Margin="0,16,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathBox" Grid.Column="0" Style="{StaticResource BaseTextBox}" Height="40"
                             IsReadOnly="True" FontSize="13" Background="#101014"/>
                    <Button Grid.Column="2" Content="Обзор…" Height="40" Style="{StaticResource BaseButton}"
                            Click="BrowsePath_Click"/>
                </Grid>

                <TextBlock Text="Обложка (картинка)" Style="{StaticResource H2Text}" Margin="0,16,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CoverBox" Grid.Column="0" Style="{StaticResource BaseTextBox}" Height="40"
                             IsReadOnly="True" FontSize="13" Background="#101014"/>
                    <Button Grid.Column="2" Content="Обзор…" Height="40" Style="{StaticResource BaseButton}"
                            Click="BrowseCover_Click"/>
                </Grid>

                <!-- Превью обложки: фиксированная высота, картинка вписана целиком -->
                <Border Margin="0,14,0,0" Height="170" CornerRadius="10" ClipToBounds="True"
                        Background="#141419" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <TextBlock x:Name="PreviewHint" Text="Обложка не выбрана — будет заглушка с первой буквой"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="430"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="PreviewImage" Stretch="Uniform" Margin="8" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="13"
                           Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки внизу: не уезжают за край окна -->
        <Border Grid.Row="2" Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SaveButton" Content="Сохранить" Height="42" Padding="24,0" FontSize="14"
                        Style="{StaticResource PrimaryButton}" Click="Save_Click" IsDefault="True"/>
                <Button Content="Отмена" Height="42" Padding="24,0" FontSize="14" Margin="10,0,0,0"
                        Style="{StaticResource BaseButton}" Click="Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
