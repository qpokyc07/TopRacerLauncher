<Window x:Class="TopRacerLauncher.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TopRacerLauncher — о приложении"
        Width="640" Height="560" ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgWindowBrush}"
        FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="0"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="О приложении" FontWeight="Bold" FontSize="15"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0"/>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                        Width="38" Height="34" Style="{StaticResource BaseButton}"
                        Click="Close_Click" Content="&#x2715;" FontSize="12"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel Margin="26,22,22,16">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/icon.png" Width="64" Height="64" Stretch="Uniform"/>
                    <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="TopRacer Launcher" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock x:Name="VersionText" Text="" FontSize="12.5"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="12" Padding="16,14" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="Для кого" FontSize="11.5" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="Приложение создано для компании Top Racer — руками сотрудника Top Racer, для удобства клуба и гостей."
                                   FontSize="13" Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="12" Padding="16,14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Права" FontSize="11.5" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="Права на приложение принадлежат ИП Хамматова Олеся Александровна и Хамматов Тимур Вадикович."
                                   FontSize="13" Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="12" Padding="16,14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Автор" FontSize="11.5" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBlock FontSize="13" Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap" LineHeight="20">
                            Создал приложение <Run FontWeight="SemiBold">Ivan Pro</Run>. Найти его можно в Telegram —
                            <Hyperlink Click="Telegram_Click" Style="{StaticResource SupportLink}">@qpokycnow</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock Text="Всем добра!" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Написать в Telegram" Height="38" Padding="18,0" FontSize="13"
                        Style="{StaticResource BaseButton}" Click="Telegram_Click" Margin="0,0,10,0"/>
                <Button Content="Закрыть" Height="38" Padding="24,0" FontSize="13.5"
                        Style="{StaticResource PrimaryButton}" Click="Close_Click" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
