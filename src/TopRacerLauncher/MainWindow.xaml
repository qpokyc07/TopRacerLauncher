<Window x:Class="TopRacerLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TopRacerLauncher"
        Title="TopRacerLauncher"
        Width="1280" Height="820"
        MinWidth="980" MinHeight="620"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgWindowBrush}"
        FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="86"/>
        </Grid.RowDefinitions>

        <!-- Анонс турнира: тонкая строка в начале трея (включается в админ-меню) -->
        <Border x:Name="TickerBar" Grid.Row="0" Height="30" Visibility="Collapsed"
                BorderBrush="#26FFFFFF" BorderThickness="0,0,0,1">
            <Grid>
                <Border Background="{DynamicResource AccentBrush}" Opacity="0.14"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0">
                    <Border Width="6" Height="6" CornerRadius="3" VerticalAlignment="Center"
                            Background="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="АНОНС ТУРНИРА" FontSize="10.5" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <TextBlock x:Name="TickerText" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Фон всего окна: размытый, чтобы панели смотрелись стеклянными -->
        <Image x:Name="AppBackgroundImage" Grid.RowSpan="4" Stretch="UniformToFill" Opacity="0.55"
               Visibility="Collapsed" Panel.ZIndex="-2">
            <Image.Effect>
                <BlurEffect Radius="26" KernelType="Gaussian"/>
            </Image.Effect>
        </Image>
        <Border x:Name="AppBackgroundOverlay" Grid.RowSpan="4" Background="#990A0A10"
                Visibility="Collapsed" Panel.ZIndex="-1"/>

        <!-- ===== Кинематографичный фон выбранной игры =====
             Размытая обложка/фон игры, мягкая тонировка темой и затемнение для читаемости.
             Два слоя картинок — чтобы переключаться кроссфейдом 250 мс. -->
        <Grid x:Name="CinemaLayer" Grid.RowSpan="4" Panel.ZIndex="-1" IsHitTestVisible="False"
              Opacity="0" ClipToBounds="True">
            <Grid x:Name="CinemaParallax" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="CinemaScale" ScaleX="1.12" ScaleY="1.12"/>
                        <TranslateTransform x:Name="CinemaShift" X="0" Y="0"/>
                    </TransformGroup>
                </Grid.RenderTransform>

                <Image x:Name="CinemaImageA" Stretch="UniformToFill" Opacity="0"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <BlurEffect Radius="34" KernelType="Gaussian"/>
                    </Image.Effect>
                </Image>
                <Image x:Name="CinemaImageB" Stretch="UniformToFill" Opacity="0"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <BlurEffect Radius="34" KernelType="Gaussian"/>
                    </Image.Effect>
                </Image>
            </Grid>

            <!-- Цвет темы: мягкое световое пятно из акцента -->
            <Border Background="{DynamicResource AccentBrush}" Opacity="0.16">
                <Border.OpacityMask>
                    <RadialGradientBrush Center="0.38,0.2" GradientOrigin="0.38,0.2"
                                         RadiusX="1" RadiusY="1.15">
                        <GradientStop Color="#B3FFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </RadialGradientBrush>
                </Border.OpacityMask>
            </Border>

            <!-- Затемнение сверху и снизу: шапка и карточки остаются читаемыми -->
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#7A090A10" Offset="0"/>
                        <GradientStop Color="#3D090A10" Offset="0.32"/>
                        <GradientStop Color="#B8090A10" Offset="0.8"/>
                        <GradientStop Color="#F2090A10" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Боковая виньетка: библиотека слева остаётся контрастной -->
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#59090A10" Offset="0"/>
                        <GradientStop Color="#00090A10" Offset="0.45"/>
                        <GradientStop Color="#33090A10" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <!-- ================= Верхняя панель ================= -->
        <Border x:Name="HeaderBar" Grid.Row="1" Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <!-- Логотип -->
                <StackPanel x:Name="LogoArea" Orientation="Horizontal" HorizontalAlignment="Left"
                            VerticalAlignment="Center" Margin="16,0,0,0" Cursor="Hand"
                            ToolTip="Открыть админ-меню" MouseLeftButtonUp="Logo_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Image Source="/Assets/logo.png" Width="44" Height="44" Stretch="Uniform"/>
                    <TextBlock Text="TopRacer" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock Text="Launcher" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center" Margin="4,0,0,0"/>

                    <Border Width="1" Height="18" Background="{StaticResource BorderBrush}" Margin="16,0"/>
                    <TextBlock Text="Библиотека" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <Border Background="#18FFFFFF" CornerRadius="9" Padding="8,2" Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="LibraryCountText" Text="пусто" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                    <TextBlock x:Name="UserNameText" Text="Профиль" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>

                    <!-- Размер карточек (иконок) игр — ползунок -->
                    <Border Width="1" Height="18" Background="{StaticResource BorderBrush}" Margin="16,0"/>
                    <TextBlock Text="Иконки:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <Slider x:Name="IconSizeSlider" Width="150" Minimum="100" Maximum="380"
                            VerticalAlignment="Center" Margin="10,0,0,0"
                            Style="{StaticResource BaseSlider}"
                            ToolTip="Размер карточек игр"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            ValueChanged="IconSizeSlider_ValueChanged"
                            PreviewMouseLeftButtonUp="IconSizeSlider_Changed"
                            PreviewKeyUp="IconSizeSlider_Changed"/>
                    <TextBlock x:Name="IconSizeLabel" Text="178" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                               Margin="8,0,0,0" MinWidth="30"/>
                </StackPanel>

                <!-- Справа: замок, статус игры, таймер, выход -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <!-- Замок: открыт (зелёный) / закрыт (красный), Ctrl+2 -->
                    <Border x:Name="LockBadge" CornerRadius="8" Padding="10,5" Margin="0,0,10,0"
                            VerticalAlignment="Center" Background="#D64545" Cursor="Hand"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            MouseLeftButtonUp="LockToggle_Click"
                            ToolTip="Ctrl+2 — заблокировать/разблокировать окно">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="11" Height="13" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Path Data="M 2,5.2 L 2,3.6 A 3.4,3.4 0 0 1 8.8,3.6 L 8.8,5.2"
                                      Stroke="White" StrokeThickness="1.5" VerticalAlignment="Top"/>
                                <Border Background="White" CornerRadius="1.5" Height="7.2"
                                        VerticalAlignment="Bottom"/>
                            </Grid>
                            <TextBlock x:Name="LockText" Text="Закрыто" FontSize="12" FontWeight="SemiBold"
                                       Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Статус игры -->
                    <Border x:Name="GameStatusChip" Background="{DynamicResource BgCardBrush}" CornerRadius="6" Padding="12,7"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="GameStatusDot" Width="8" Height="8" Fill="#6E6E7A" Margin="0,0,8,0"
                                     VerticalAlignment="Center">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <!-- Пульсация при запущенной игре -->
                                    <EventTrigger RoutedEvent="Ellipse.Loaded">
                                        <BeginStoryboard x:Name="DotPulse">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="1.6" Duration="0:0:0.7" AutoReverse="True">
                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="1.6" Duration="0:0:0.7" AutoReverse="True">
                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock x:Name="GameStatusText" Text="Игра не запущена" FontSize="12.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Таймер сеанса -->
                    <Border x:Name="TimerChip" Background="{DynamicResource BgCardBrush}" CornerRadius="6" Padding="12,7"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"/>
                                <Line X1="8" Y1="3.5" X2="8" Y2="8.2" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"/>
                                <Line X1="8" Y1="8.2" X2="11.4" Y2="10.4" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"/>
                            </Grid>
                            <TextBlock x:Name="TimerChipText" Text="--:--" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>


                    <!-- Завершить сессию (для клуба) -->
                    <Button x:Name="EndSessionButton" Content="Завершить" Height="30" Padding="14,0"
                            FontSize="12" Margin="0,0,10,0" Style="{StaticResource BaseButton}"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="EndSession_Click"
                            ToolTip="Завершить сессию и вернуть экран приветствия"/>

                    <!-- Кнопки окна: свернуть / развернуть / закрыть -->
                    <Button Content="&#x2500;" Style="{StaticResource CaptionButton}"
                            Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Свернуть"/>
                    <Button x:Name="MaximizeButton" Content="&#x25A1;" Style="{StaticResource CaptionButton}"
                            Click="ToggleMaximize_Click" WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Развернуть / восстановить"/>
                    <Button Content="&#x2715;" Style="{StaticResource CaptionCloseButton}"
                            Click="CloseApp_Click" WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Закрыть лаунчер"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Библиотека игр ================= -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Афиша клуба: карточки с фото и текстом -->
            <Border x:Name="AfishaStrip" Grid.Row="0" Grid.ColumnSpan="2" Margin="26,16,26,0"
                    Visibility="Collapsed">
                <ScrollViewer x:Name="AfishaScroll" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="AfishaItems" Margin="0,0,0,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DataTemplate.Resources>
                                    <local:BoolToVisibilityConverter x:Key="AfishaVis"/>
                                </DataTemplate.Resources>

                                <Border Width="310" Height="130" Margin="0,0,16,0" CornerRadius="16"
                                        ClipToBounds="True" BorderThickness="1"
                                        RenderTransformOrigin="0.5,0.5" Cursor="Hand"
                                        ToolTip="{Binding Text}">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="Black" BlurRadius="16"
                                                                      ShadowDepth="0" Opacity="0.35"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="Black" BlurRadius="24"
                                                                              ShadowDepth="0" Opacity="0.6"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                 To="1.025" Duration="0:0:0.16">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                 To="1.025" Duration="0:0:0.16">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                 To="1" Duration="0:0:0.16"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                 To="1" Duration="0:0:0.16"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Image Source="{Binding Image}" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding HasImage, Converter={StaticResource AfishaVis}}"/>

                                        <!-- Без фото: мягкая заливка цветом темы -->
                                        <Grid Visibility="{Binding HasNoImage, Converter={StaticResource AfishaVis}}">
                                            <Border Background="{DynamicResource BgCardBrush}"/>
                                            <Border Background="{DynamicResource AccentBrush}" Opacity="0.28">
                                                <Border.OpacityMask>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#CCFFFFFF" Offset="0"/>
                                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.OpacityMask>
                                            </Border>
                                        </Grid>

                                        <!-- Затемнение снизу, чтобы текст читался на любом фото -->
                                        <Border>
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00000000" Offset="0"/>
                                                    <GradientStop Color="#B3000000" Offset="0.5"/>
                                                    <GradientStop Color="#E6000000" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <StackPanel VerticalAlignment="Bottom" Margin="16,0,16,12">
                                            <Border HorizontalAlignment="Left" CornerRadius="7" Padding="8,3"
                                                    Margin="0,0,0,7" Background="#33FFFFFF"
                                                    Visibility="{Binding HasDate, Converter={StaticResource AfishaVis}}">
                                                <TextBlock Text="{Binding DateText}" FontSize="10.5"
                                                           FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontSize="15.5" FontWeight="Bold"
                                                       Foreground="White" TextWrapping="Wrap"
                                                       LineHeight="19" MaxHeight="42"/>
                                            <TextBlock Text="{Binding Text}" FontSize="11.5" Margin="0,4,0,0"
                                                       Foreground="#D9FFFFFF" TextWrapping="Wrap"
                                                       LineHeight="15" MaxHeight="32"
                                                       Visibility="{Binding HasText, Converter={StaticResource AfishaVis}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <ScrollViewer x:Name="LibraryScroll" Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0"
                          ScrollChanged="Library_ScrollChanged">
                <ItemsControl x:Name="GamesItems" Margin="26,22,26,26">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DataTemplate.Resources>
                                <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
                            </DataTemplate.Resources>

                            <Border Margin="0,0,20,24" Cursor="Hand"
                                    Width="{Binding Ui.CardWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                    RenderTransformOrigin="0.5,0.5"
                                    BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
                                    MouseLeftButtonUp="Card_Click"
                                    MouseRightButtonUp="Card_RightClick"
                                    MouseEnter="Card_MouseEnter">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
                                        <Setter Property="CornerRadius" Value="14"/>
                                        <Setter Property="Opacity" Value="0"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="0" Opacity="0"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <!-- Плавное появление карточки при загрузке -->
                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         To="1" Duration="0:0:0.4">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                             To="1.035" Duration="0:0:0.18">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                             To="1.035" Duration="0:0:0.18">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                             To="1.0" Duration="0:0:0.18">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                             To="1.0" Duration="0:0:0.18">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel>
                                    <!-- Обложка с задним фоном -->
                                    <Border Height="{Binding Ui.CardHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CornerRadius="14,14,0,0" ClipToBounds="True"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,1,0">
                                        <Grid>
                                            <!-- Задний фон (широкая картинка) -->
                                            <Image Source="{Binding BackgroundImage}" Stretch="UniformToFill"
                                                   Visibility="{Binding HasBackground, Converter={StaticResource BoolToVis}}"/>
                                            <Border Background="#73000000"
                                                    Visibility="{Binding HasBackground, Converter={StaticResource BoolToVis}}"/>
                                            <!-- Заглушка + шиммер (пока нет обложки) -->
                                            <Grid ClipToBounds="True"
                                                  Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVis}}">
                                                <Border Background="{Binding PlaceholderBrush}"/>
                                                <Border Width="130" HorizontalAlignment="Left" Opacity="0.45">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                                                            <GradientStop Color="#66FFFFFF" Offset="0.5"/>
                                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Border.RenderTransform>
                                                        <TranslateTransform X="-160"/>
                                                    </Border.RenderTransform>
                                                    <Border.Triggers>
                                                        <EventTrigger RoutedEvent="Loaded">
                                                            <BeginStoryboard>
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                        From="-160" To="380" Duration="0:0:1.8"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Border.Triggers>
                                                </Border>
                                            </Grid>
                                            <!-- Буква-инициал, если нет обложки -->
                                            <TextBlock Text="{Binding Initial}"
                                                       FontSize="{Binding Ui.CoverFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       FontWeight="Bold"
                                                       Foreground="#80FFFFFF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding ShowInitial, Converter={StaticResource BoolToVis}}"/>
                                            <!-- Обложка поверх фона -->
                                            <Image Source="{Binding CoverImage}" Stretch="Uniform" Margin="12"
                                                   Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}">
                                                <Image.Effect>
                                                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.7"/>
                                                </Image.Effect>
                                            </Image>
                                            <!-- Мягкий градиент снизу -->
                                            <Border VerticalAlignment="Bottom" Height="70" IsHitTestVisible="False">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#00000000" Offset="0"/>
                                                        <GradientStop Color="#8C000000" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>

                                            <!-- Бейдж «играет» -->
                                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="3"
                                                    Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Margin="8,8,0,0"
                                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="ИГРАЕТ" FontSize="10" FontWeight="Bold"
                                                           Foreground="White"/>
                                            </Border>

                                            <!-- Замок: игра заблокирована администратором -->
                                            <Border Background="#E6D64545" CornerRadius="8"
                                                    Padding="7,4" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,8,8,0"
                                                    Visibility="{Binding IsHidden, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#x1F512;" FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBlock Text="СКРЫТА" FontSize="9.5" FontWeight="Bold"
                                                               Foreground="White" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Название -->
                                    <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="Bold"
                                               Foreground="{Binding TitleForeground}"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               MaxHeight="58" Margin="10,10,10,12">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="1" Opacity="0.55"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ===== Карточка выбранной игры ===== -->
            <Grid Grid.Row="1" Grid.Column="1" Width="360" Margin="0,22,26,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.4*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="0.65*"/>
                </Grid.RowDefinitions>

            <Border x:Name="DetailsPanel" Grid.Row="0"
                    Background="{DynamicResource BgPanelBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
                    CornerRadius="18" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="DetailsToggle" Grid.Row="0" Margin="0,0,0,6"
                            Style="{StaticResource SectionHeaderButton}" Click="ToggleDetails_Click"
                            ToolTip="Свернуть / развернуть описание">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path x:Name="DetailsChevron" Data="M 0,0 L 10,0 L 5,6 Z"
                                  Fill="{StaticResource TextSecondaryBrush}" Width="10" Height="6"
                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" x:Name="DetailsHeaderText" Text="Описание"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <ScrollViewer x:Name="DetailsBody" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border x:Name="DetailCoverBlock" CornerRadius="12" Height="100" ClipToBounds="True" Background="#26FFFFFF">
                            <Grid>
                                <Image x:Name="DetailCover" Stretch="UniformToFill"/>
                                <TextBlock x:Name="DetailCoverLetter" Text="" FontSize="64" FontWeight="Bold"
                                           Foreground="#59FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="DetailTitle" Text="Выберите игру" FontSize="18.5" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="2,12,2,0"/>
                        <TextBlock x:Name="DetailSubtitle" Text="" FontSize="12.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="2,4,2,0"/>
                        <TextBlock x:Name="DetailGenres" Text="" FontSize="12"
                                   Foreground="{DynamicResource AccentBrush}"
                                   TextWrapping="Wrap" Margin="2,8,2,0"/>
                        <TextBlock x:Name="DetailDescription" Text="" FontSize="13.5" Foreground="#DCDCE6"
                                   TextWrapping="Wrap" LineHeight="20" Margin="2,12,2,0"/>

                        <Button x:Name="DetailPlayButton" Content="Играть" Height="42" Margin="0,16,0,0"
                                Style="{StaticResource PrimaryButton}" Click="DetailPlay_Click"/>
                    </StackPanel>
                </ScrollViewer>

                    <!-- Характеристики ПК (сворачиваемые) -->
                    <Border x:Name="PcInfoBlock" Grid.Row="2" Margin="0,10,0,0" Padding="0,8,0,0"
                            BorderBrush="#26FFFFFF" BorderThickness="0,1,0,0">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Скрыть характеристики ПК" Click="HidePcSpecs_Click"
                                          ToolTip="Вернуть блок можно в админ-меню → Оформление"/>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <StackPanel>
                            <Button x:Name="PcInfoToggle" Style="{StaticResource SectionHeaderButton}"
                                    Click="TogglePcInfo_Click" ToolTip="Свернуть / развернуть характеристики">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="PcInfoChevron" Data="M 0,0 L 10,0 L 5,6 Z"
                                          Fill="{StaticResource TextSecondaryBrush}" Width="10" Height="6"
                                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="Характеристики ПК" FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Grid>
                            </Button>

                            <StackPanel x:Name="PcInfoBody" Margin="18,8,0,0">
                                <TextBlock x:Name="PcCpuText" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="PcRamText" FontSize="11.5" Margin="0,3,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="PcGpuText" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="PcOsText" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== Друзья в локальной сети ===== -->
            <Border x:Name="FriendsPanel" Grid.Row="2" Background="{DynamicResource BgPanelBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
                    CornerRadius="18" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock Text="Друзья в сети" FontWeight="Bold" FontSize="14"
                                   Foreground="{StaticResource TextBrush}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Статус" Height="24" Padding="10,0" FontSize="11"
                                    Style="{StaticResource BaseButton}" Click="Status_Click"
                                    ToolTip="Мой статус для друзей"/>
                            <TextBlock x:Name="FriendsCount" Text="" FontSize="12" Margin="8,0,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="FriendsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DataTemplate.Resources>
                                        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
                                    </DataTemplate.Resources>
                                    <Border Background="#14FFFFFF" CornerRadius="10" Padding="10,8"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{Binding NameBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#E6D64545" CornerRadius="9"
                                                    MinWidth="18" Height="18" Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding ShowUnread, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding Unread}" FontSize="10.5" FontWeight="Bold"
                                                           Foreground="White" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" Margin="5,0"/>
                                            </Border>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="&#x2709;" Width="30" Height="28" Padding="0" FontSize="12"
                                                        Style="{StaticResource CaptionButton}" Click="FriendChat_Click"
                                                        ToolTip="Написать"/>
                                                <Button Content="&#x1F4DE;" Width="30" Height="28" Padding="0" FontSize="12"
                                                        Margin="4,0,0,0" Style="{StaticResource CaptionButton}"
                                                        Click="FriendCall_Click" ToolTip="Позвонить"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="FriendsEmpty" Grid.Row="1" Text="Пока никого нет в сети"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            </Grid>

            <!-- Пустая библиотека -->
            <StackPanel x:Name="EmptyState" Grid.Column="0" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource BgCardBrush}"
                        HorizontalAlignment="Center">
                    <TextBlock Text="&#x1F4E6;" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="EmptyTitle" Text="Библиотека пуста" Style="{StaticResource H1Text}"
                           HorizontalAlignment="Center" Margin="0,18,0,0"/>
                <TextBlock x:Name="EmptyHint" Text="Добавьте игры в админ-меню: Ctrl+1"
                           Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ================= Нижняя панель ================= -->
        <Border x:Name="BottomBar" Grid.Row="3" Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Остаток времени -->
                <StackPanel x:Name="TimerPanel" Grid.Column="0" VerticalAlignment="Center" Width="330" Visibility="Collapsed">
                    <Grid>
                        <TextBlock x:Name="SessionStatusText" Text="Сеанс не запущен" FontSize="13"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SessionTotalText" Text="" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <ProgressBar x:Name="TimeProgress" Minimum="0" Maximum="100" Value="0"
                                 Margin="0,9,0,0" Height="7" Style="{StaticResource TimerProgress}"/>
                </StackPanel>

                <!-- Быстрые ссылки слева -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                    <Button Content="Браузер" Height="36" Padding="18,0" FontSize="13" FontWeight="SemiBold"
                            Style="{StaticResource PrimaryButton}" Click="OpenBrowser_Click" Margin="0,0,8,0"
                            ToolTip="Открыть браузер (в закрытом режиме — по паролю)"/>
                    <Button Content="Steam" Height="36" Padding="18,0" FontSize="13" FontWeight="SemiBold"
                            Style="{StaticResource PrimaryButton}" Click="OpenSteam_Click"
                            ToolTip="Открыть Steam (в закрытом режиме — по паролю)"/>
                    <Button Height="36" Padding="14,0" Margin="8,0,0,0"
                            Style="{StaticResource BaseButton}" Click="SteamFriends_Click"
                            ToolTip="Список друзей Steam">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                                  Fill="{DynamicResource AccentBrush}" Width="16" Height="16" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Друзья Steam" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Справка по центру -->
                <Button Grid.Column="1" Width="38" Height="38" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Style="{StaticResource CaptionButton}"
                        Click="Help_Click" ToolTip="Как играть" Content="?&#x20;" FontSize="20"
                        FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>

                <!-- Акция и ссылка справа -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="AchievementsButton" Content="Достижения" Height="30" Padding="14,0"
                            FontSize="11.5" FontWeight="SemiBold" Margin="0,0,8,0"
                            Style="{StaticResource BaseButton}" Click="Achievements_Click"
                            ToolTip="Полка достижений: часы, серии дней, рекорды"/>
                    <Button Content="Промокод" Height="30" Padding="14,0" FontSize="11.5"
                            FontWeight="SemiBold" Margin="0,0,8,0"
                            Style="{StaticResource BaseButton}" Click="PromoCode_Click"
                            ToolTip="Ввести код на дополнительные минуты"/>
                    <Button Content="Хочешь до 30 минут бесплатно?" Height="30" Padding="14,0"
                            FontSize="11.5" FontWeight="SemiBold" Margin="0,0,16,0"
                            Style="{StaticResource PrimaryButton}" Click="Promo_Click"/>
                    <TextBlock VerticalAlignment="Center" FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}">
                        По всем вопросам —
                        <Hyperlink Click="Support_Click" Style="{StaticResource SupportLink}">@qpokycnow</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Экран приветствия (киоск/клуб) ===== -->
        <Grid x:Name="WelcomeOverlay" Grid.RowSpan="4" Panel.ZIndex="50" Visibility="Collapsed"
              Background="#C7080A0E">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#x1F44B;" FontSize="46" HorizontalAlignment="Center"/>
                <TextBlock Text="Добро пожаловать" FontSize="38" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>
                <TextBlock Text="Top Racer" FontSize="58" FontWeight="Black"
                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                           Margin="0,2,0,0"/>
                <TextBlock Text="Следи за нами в соцсетях" FontSize="20" FontWeight="SemiBold"
                           Foreground="White" HorizontalAlignment="Center"
                           Margin="0,18,0,0"/>
                <TextBlock Text="Розыгрыши бесплатных минут и ценные призы — каждый месяц"
                           FontSize="16.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" Margin="0,7,0,0"/>

                <!-- Реклама постов из соцсетей (текст задаётся в админ-меню) -->
                <Border x:Name="WelcomeAdCard" MaxWidth="680" Margin="0,18,0,0" Padding="22,14"
                        CornerRadius="16" Background="#1FFFFFFF" BorderBrush="#3DFFFFFF" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}"
                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="WelcomeAdTitleText" FontSize="15" FontWeight="Bold"
                                       Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="WelcomeAdTextText" FontSize="13" Foreground="#D9FFFFFF"
                                   TextAlignment="Center" TextWrapping="Wrap" LineHeight="18"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                    <StackPanel x:Name="QrBlock1" Margin="0,0,18,0">
                        <Border Width="160" Height="160" CornerRadius="12" Background="Transparent"
                                BorderBrush="#22FFFFFF" BorderThickness="1">
                            <Image x:Name="Qr1" Stretch="Uniform" Margin="8"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Border Width="22" Height="22" CornerRadius="11" Background="#2AABEE">
                                <TextBlock Text="TG" FontSize="9" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Телеграм" FontSize="13.5" Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center" Margin="7,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="QrBlock2" Margin="0,0,18,0">
                        <Border Width="160" Height="160" CornerRadius="12" Background="Transparent"
                                BorderBrush="#22FFFFFF" BorderThickness="1">
                            <Image x:Name="Qr2" Stretch="Uniform" Margin="8"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Border Width="22" Height="22" CornerRadius="11" Background="#0077FF">
                                <TextBlock Text="VK" FontSize="9" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="ВКонтакте" FontSize="13.5" Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center" Margin="7,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="QrBlock3">
                        <Border Width="160" Height="160" CornerRadius="12" Background="Transparent"
                                BorderBrush="#22FFFFFF" BorderThickness="1">
                            <Image x:Name="Qr3" Stretch="Uniform" Margin="8"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Border Width="22" Height="22" CornerRadius="11" Background="#FF6B00">
                                <TextBlock Text="M" FontSize="11" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="MAX" FontSize="13.5" Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center" Margin="7,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <Button Content="Начать" Width="300" Height="50" Margin="0,26,0,0"
                        FontSize="16" FontWeight="SemiBold" Style="{StaticResource PrimaryButton}"
                        Click="WelcomeStart_Click"/>

                <!-- Тарифы: быстрый старт сессии -->
                <TextBlock Text="Выберите время сессии" FontSize="12.5" TextAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,22,0,8"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="30 минут" Width="150" Height="38" Style="{StaticResource BaseButton}"
                            Margin="0,0,10,0" FontSize="13" Click="WelcomeTariff_Click" Tag="30"/>
                    <Button Content="1 час" Width="150" Height="38" Style="{StaticResource BaseButton}"
                            Margin="0,0,10,0" FontSize="13" Click="WelcomeTariff_Click" Tag="60"/>
                    <Button Content="2 часа" Width="150" Height="38" Style="{StaticResource BaseButton}"
                            FontSize="13" Click="WelcomeTariff_Click" Tag="120"/>
                </StackPanel>


            </StackPanel>
        </Grid>
    </Grid>
</Window>
