<Window x:Class="TopRacerLauncher.PromoRedeemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TopRacerLauncher"
        Width="450" Height="238"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI">
    <Border CornerRadius="16" Background="#F50C0E13" BorderBrush="#40FFFFFF" BorderThickness="1"
            Padding="22,18">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="26" ShadowDepth="6" Opacity="0.55"/>
        </Border.Effect>

        <StackPanel VerticalAlignment="Center">
            <Grid>
                <TextBlock Text="Промокод на минуты" FontSize="16.5" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>

                <!-- Крестик в орнаментальном кольце -->
                <Button Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="Close_Click" ToolTip="Закрыть" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Ring" CornerRadius="14" Background="#14FFFFFF"
                                    BorderBrush="#59FFFFFF" BorderThickness="1">
                                <TextBlock Text="&#x2715;" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="White" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ring" Property="Background" Value="#33FFFFFF"/>
                                    <Setter TargetName="Ring" Property="BorderBrush"
                                            Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <TextBlock Text="Введите код, который дал администратор"
                       FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,7,0,11"/>

            <TextBox x:Name="CodeBox" Style="{StaticResource BaseTextBox}" Height="40" FontSize="15"
                     MaxLength="16" KeyDown="CodeBox_KeyDown"/>

            <TextBlock x:Name="MessageText" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                       Foreground="{StaticResource DangerBrush}" Visibility="Collapsed"/>

            <Button Content="Активировать" Height="40" Margin="0,14,0,0"
                    Style="{StaticResource PrimaryButton}" Click="Redeem_Click"/>
        </StackPanel>
    </Border>
</Window>
