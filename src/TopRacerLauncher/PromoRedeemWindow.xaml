<Window x:Class="TopRacerLauncher.PromoRedeemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TopRacerLauncher"
        Width="420" Height="240"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI">
    <Border CornerRadius="16" Background="#F50C0E13" BorderBrush="#40FFFFFF" BorderThickness="1"
            Padding="24,20">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="26" ShadowDepth="6" Opacity="0.55"/>
        </Border.Effect>

        <StackPanel>
            <Grid>
                <TextBlock Text="Промокод на минуты" FontSize="17" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right" Width="30" Height="26" Content="&#x2715;"
                        FontSize="10" Style="{StaticResource CaptionButton}" Click="Close_Click"/>
            </Grid>

            <TextBlock Text="Введите код, который дал администратор"
                       FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,10"/>

            <TextBox x:Name="CodeBox" Style="{StaticResource BaseTextBox}" Height="38" FontSize="15"
                     MaxLength="16" KeyDown="CodeBox_KeyDown"/>

            <TextBlock x:Name="MessageText" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                       Foreground="{StaticResource DangerBrush}" Visibility="Collapsed"/>

            <Button Content="Активировать" Height="38" Margin="0,14,0,0"
                    Style="{StaticResource PrimaryButton}" Click="Redeem_Click"/>
        </StackPanel>
    </Border>
</Window>
