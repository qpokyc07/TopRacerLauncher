<Window x:Class="TopRacerLauncher.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TopRacerLauncher"
        Title="TopRacerLauncher"
        Width="540" Height="268"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgWindowBrush}"
        FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="0"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Grid Grid.Row="0" Background="{DynamicResource BgPanelBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0">
                <TextBlock Text="TopRacer" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Launcher" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="4,0,0,0"/>
            </StackPanel>
            <Button x:Name="CloseButton" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                    Width="30" Height="28" Style="{StaticResource CaptionButton}"
                    Click="Close_Click" Content="&#x2715;" FontSize="10" WindowChrome.IsHitTestVisibleInChrome="True"/>
        </Grid>

        <!-- Тело: горизонтальная компоновка -->
        <Grid Grid.Row="1" Margin="24,16,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="IconBadge" Grid.Column="0" Width="64" Height="64" CornerRadius="32"
                    Background="#2A3F5F" VerticalAlignment="Center" Margin="0,0,20,0">
                <TextBlock x:Name="IconText" Text="&#x1F512;" FontSize="26"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="Вход в TopRacerLauncher"
                           FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="SubtitleText" Text="Введите пароль администратора"
                           FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>

                <local:MaskedInput x:Name="PasswordInput" Style="{StaticResource BaseTextBox}" Height="36"
                                   FontSize="13" MaxLength="64" KeyDown="Password_KeyDown" Margin="0,12,0,0"/>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="11.5"
                           Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SubmitButton" Grid.Column="0" Content="Войти" Style="{StaticResource PrimaryButton}"
                            Height="36" FontSize="13" Click="Submit_Click" IsDefault="True"/>
                    <Button x:Name="CancelButton" Grid.Column="1" Content="Отмена" Style="{StaticResource BaseButton}"
                            Height="36" FontSize="12" Margin="8,0,0,0" Click="Close_Click" IsCancel="True"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
