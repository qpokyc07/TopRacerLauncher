<Window x:Class="TopRacerLauncher.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TopRacerLauncher"
        Title="TopRacerLauncher"
        Width="470" Height="520"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgWindowBrush}"
        FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="0"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Grid Grid.Row="0" Background="{DynamicResource BgPanelBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0">
                <TextBlock Text="TopRacer" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Launcher" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource AccentBrush}" Margin="4,0,0,0"/>
            </StackPanel>
            <Button x:Name="CloseButton" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                    Width="38" Height="34" Style="{StaticResource BaseButton}"
                    Click="Close_Click" Content="&#x2715;" FontSize="12" WindowChrome.IsHitTestVisibleInChrome="True"/>
        </Grid>

        <!-- Тело -->
        <StackPanel Grid.Row="1" Margin="32,24,32,24">
            <Border x:Name="IconBadge" Width="56" Height="56" CornerRadius="28" Background="#2A3F5F"
                    HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock x:Name="IconText" Text="&#x1F512;" FontSize="24"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock x:Name="TitleText" Text="Вход в TopRacerLauncher"
                       Style="{StaticResource H1Text}" HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock x:Name="SubtitleText"
                       Text="Введите пароль администратора"
                       Style="{StaticResource SecondaryText}" HorizontalAlignment="Center"
                       TextAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap"/>

            <TextBlock Text="Пароль" Style="{StaticResource H2Text}" Margin="0,24,0,8"/>
            <local:MaskedInput x:Name="PasswordInput" Style="{StaticResource BaseTextBox}" Height="42"
                               MaxLength="64" KeyDown="Password_KeyDown"/>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="13"
                       Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

            <Button x:Name="SubmitButton" Content="Войти" Style="{StaticResource PrimaryButton}"
                    Height="44" FontSize="14" Margin="0,22,0,0" Click="Submit_Click" IsDefault="True"/>
            <Button x:Name="CancelButton" Content="Отмена" Style="{StaticResource BaseButton}"
                    Height="40" Margin="0,10,0,0" Click="Close_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
