<Window x:Class="TopRacerLauncher.CoverSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TopRacerLauncher"
        Title="TopRacerLauncher — Поиск картинок"
        Width="720" Height="640"
        MinWidth="560" MinHeight="480"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgWindowBrush}"
        FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="74"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock x:Name="TitleText" Text="Поиск картинок в интернете" FontWeight="Bold" FontSize="15"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0"/>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                        Width="40" Height="34" Style="{StaticResource BaseButton}"
                        Click="Cancel_Click" Content="&#x2715;" FontSize="12" WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <!-- Тело -->
        <Grid Grid.Row="1" Margin="22,18,22,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Запрос -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="Название игры" Style="{StaticResource H2Text}" Margin="0,0,0,7"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="QueryBox" Grid.Column="0" Style="{StaticResource BaseTextBox}" Height="40"
                             FontSize="14" Foreground="{StaticResource TextBrush}"
                             MaxLength="120" KeyDown="QueryBox_KeyDown"/>
                    <Button Grid.Column="2" x:Name="SearchButton" Content="Найти" Height="40"
                            Style="{StaticResource PrimaryButton}" Click="Search_Click"/>
                </Grid>
            </StackPanel>

            <!-- Статус -->
            <Grid Grid.Row="1" Margin="0,12,0,10">
                <TextBlock x:Name="StatusText" Text="Введите название и нажмите «Найти»"
                           Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                <ProgressBar x:Name="Progress" Height="4" HorizontalAlignment="Stretch"
                             VerticalAlignment="Bottom" IsIndeterminate="False" Value="0" Maximum="100"
                             Visibility="Collapsed"/>
            </Grid>

            <!-- Результаты -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed" x:Name="ResultsScroll">
                <ItemsControl x:Name="ResultsItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DataTemplate.Resources>
                                <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
                            </DataTemplate.Resources>
                            <Border x:Name="Card" Width="150" Height="170" Margin="0,0,14,14"
                                    CornerRadius="5" Cursor="Hand" Background="{DynamicResource BgCardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    MouseLeftButtonUp="Card_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                    <Border x:Name="SelectedMark" Background="#993B82D6"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                                            CornerRadius="4">
                                        <TextBlock Text="✓" FontSize="30" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Background="#CC101014" VerticalAlignment="Bottom" Padding="6,4">
                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#E9E9EE"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="30" TextWrapping="Wrap"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Нижние кнопки -->
        <Border Grid.Row="2" Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="22,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ApplyButton" Content="Использовать выбранное" Height="42" Padding="18,0"
                            Style="{StaticResource PrimaryButton}" Click="Apply_Click" IsEnabled="False"/>
                    <Button Content="Файл с компьютера…" Height="42" Padding="16,0" Margin="10,0,0,0"
                            Style="{StaticResource BaseButton}" Click="BrowseLocal_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="RemoveButton" Content="Убрать картинку" Height="42" Padding="16,0"
                            Style="{StaticResource DangerButton}" Click="Remove_Click"/>
                    <Button Content="Отмена" Height="42" Padding="18,0" Margin="10,0,0,0"
                            Style="{StaticResource BaseButton}" Click="Cancel_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
