<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Version>1.9.32</Version>
    <AssemblyVersion>1.9.50.0</AssemblyVersion>
    <FileVersion>1.9.50.0</FileVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TopRacerLauncher</AssemblyName>
    <RootNamespace>TopRacerLauncher</RootNamespace>
    <AssemblyTitle>TopRacerLauncher</AssemblyTitle>
    <Product>TopRacerLauncher</Product>
    <Company>TopRacer</Company>
    <Description>Игровой лаунчер с закрытой системой и таймером</Description>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
        <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\qr-tg.png" />
    <Resource Include="Assets\qr-vk.png" />
    <Resource Include="Assets\qr-max.png" />
  </ItemGroup>

</Project>
