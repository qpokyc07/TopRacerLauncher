<Window x:Class="TopRacerLauncher.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TopRacerLauncher"
        Width="440" Height="380"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgWindowBrush}"
        FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="50" ResizeBorderThickness="0"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="Обновление программы" FontWeight="Bold" FontSize="14"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                        Width="36" Height="32" Style="{StaticResource CaptionButton}"
                        Click="Close_Click" Content="&#x2715;" FontSize="11"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="16,14,16,0">
            <TextBlock x:Name="VersionText" Text="Доступна новая версия" FontWeight="SemiBold" FontSize="14"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock x:Name="CurrentText" Text="" FontSize="11.5"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            <TextBlock FontSize="11.5" Margin="0,6,0,0">
                <Hyperlink Click="History_Click" Style="{StaticResource SupportLink}">Что было в прошлых версиях</Hyperlink>
            </TextBlock>
        </StackPanel>

        <Border Grid.Row="2" Margin="16,12,16,0" Background="#14FFFFFF" CornerRadius="10" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="NotesText" Text="" FontSize="12.5" TextWrapping="Wrap"
                           Foreground="{StaticResource TextBrush}"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Margin="16,12,16,16">
            <ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="100" Value="0"
                         Visibility="Collapsed" Margin="0,0,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="LaterButton" Grid.Column="0" Content="Позже" Height="40"
                        Style="{StaticResource BaseButton}" Click="Close_Click"/>
                <Button x:Name="InstallButton" Grid.Column="1" Content="Загрузить и обновить" Height="40"
                        Padding="18,0" Margin="10,0,0,0" Style="{StaticResource PrimaryButton}"
                        Click="Install_Click"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
