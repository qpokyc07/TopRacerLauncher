<Window x:Class="TopRacerLauncher.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TopRacerLauncher — быстрая настройка"
        Width="640" Height="600" ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgWindowBrush}"
        FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="0"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="Быстрая настройка клуба" FontWeight="Bold" FontSize="15"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0"/>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                        Width="38" Height="34" Style="{StaticResource BaseButton}"
                        Click="Later_Click" Content="&#x2715;" FontSize="12"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel Margin="26,20,22,12">
                <TextBlock Text="Эти параметры можно менять в любой момент в админ-меню (Ctrl+1)."
                           Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                <!-- Киоск -->
                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="KioskCheck" Content="Киоск-режим"
                                  FontSize="13.5" FontWeight="SemiBold"/>
                        <TextBlock Text="Лаунчер на весь экран и поверх остальных окон, пока игра не запущена: гость не свернёт лаунчер и не уйдёт в Windows. На время игры защита уступает место игре."
                                   Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="24,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Оверлей -->
                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="OverlayCheck" Content="Оверлей управления в игре"
                                  FontSize="13.5" FontWeight="SemiBold"/>
                        <TextBlock Text="Поверх игры появляется полупрозрачная клавиатура: подсвечены клавиши, которые нужны в этой игре, и мышь. Включается и выключается клавишами Ctrl+3. Клики проходят сквозь оверлей."
                                   Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="24,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Достижения -->
                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="AchievementsCheck" Content="Достижения"
                                  FontSize="13.5" FontWeight="SemiBold"/>
                        <TextBlock Text="Всплывающие награды за сыгранные часы, серии дней и рекорды, плюс окно с полкой достижений."
                                   Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="24,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Автодополнение Steam -->
                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="AutoAddCheck" Content="Само добавлять игры из Steam"
                                  FontSize="13.5" FontWeight="SemiBold"/>
                        <TextBlock Text="Установили игру в Steam — она сама появится в библиотеке вместе с обложкой и описанием."
                                   Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="24,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Автоскан -->
                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="12" Padding="16,14">
                    <StackPanel>
                        <CheckBox x:Name="AutoScanCheck" Content="Искать игры при запуске"
                                  FontSize="13.5" FontWeight="SemiBold"/>
                        <TextBlock Text="При старте лаунчер проверяет ПК (Steam, Epic, GOG, ярлыки) и добавляет игры, которых ещё нет в библиотеке."
                                   Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="24,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Готово" Height="40" Padding="26,0" FontSize="13.5"
                        Style="{StaticResource PrimaryButton}" Click="Save_Click" IsDefault="True"/>
                <Button Content="Настроить позже" Height="40" Padding="22,0" FontSize="13.5" Margin="10,0,0,0"
                        Style="{StaticResource BaseButton}" Click="Later_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
