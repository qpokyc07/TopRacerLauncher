<Window x:Class="TopRacerLauncher.NoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TopRacerLauncher"
        SizeToContent="WidthAndHeight" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" WindowStartupLocation="Manual"
        FontFamily="Segoe UI" Cursor="Hand">
    <Border Width="330" CornerRadius="12" Background="#F21A1014"
            BorderBrush="#66FF4D6D" BorderThickness="1" Padding="14,12">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="5" Opacity="0.55"/>
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x2709;" FontSize="14" Foreground="#FF6B85" VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleText" Text="Новое сообщение" FontWeight="Bold" FontSize="13"
                           Foreground="#FF9AAF" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="BodyText" Text="" FontSize="12.5" Foreground="White"
                       TextWrapping="Wrap" MaxHeight="66" Margin="0,6,0,0"/>
        </StackPanel>
    </Border>
</Window>
