<Window x:Class="TopRacerLauncher.CallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TopRacerLauncher"
        Width="430" Height="580"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgWindowBrush}"
        FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="50" ResizeBorderThickness="0"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock x:Name="HeaderText" Text="Звонок" FontWeight="Bold" FontSize="14"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBlock x:Name="CountText" Text="" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,50,0"/>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                        Width="36" Height="32" Style="{StaticResource CaptionButton}"
                        Click="Close_Click" Content="&#x2715;" FontSize="11"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <!-- Индикатор речи -->
        <Border Grid.Row="1" x:Name="TalkBadge" Margin="16,12,16,0" CornerRadius="10" Padding="12,8"
                Background="#1F2A22" BorderBrush="#2E7D5B" BorderThickness="1">
            <TextBlock x:Name="TalkText" Text="Микрофон выключен" FontSize="12.5"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>

        <!-- Участники -->
        <ScrollViewer Grid.Row="2" Margin="16,12,16,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ParticipantsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#14FFFFFF" CornerRadius="10" Padding="12,8" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Status}" FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Настройки звука -->
        <StackPanel Grid.Row="3" Margin="16,10,16,0">
            <Button x:Name="MicButton" Content="Микрофон: —" Height="34" HorizontalAlignment="Stretch"
                    Style="{StaticResource BaseButton}" Click="MicButton_Click" Margin="0,0,0,8"/>
            <Button x:Name="SpkButton" Content="Наушники: —" Height="34" HorizontalAlignment="Stretch"
                    Style="{StaticResource BaseButton}" Click="SpkButton_Click" Margin="0,0,0,8"/>
            <Button x:Name="ModeButton" Content="Режим: по кнопке" Height="34"
                    HorizontalAlignment="Left" Padding="14,0" FontSize="12"
                    Style="{StaticResource BaseButton}" Click="ToggleMode_Click"/>
        </StackPanel>
        <!-- Кнопки -->
        <Grid Grid.Row="4" Margin="16,12,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Пригласить друзей" Height="40" FontSize="13"
                    Style="{StaticResource BaseButton}" Click="Invite_Click"/>
            <Button Grid.Column="1" Content="Завершить" Height="40" Padding="18,0" FontSize="13"
                    Margin="10,0,0,0" Style="{StaticResource DangerButton}" Click="HangUp_Click"/>
        </Grid>
    </Grid>
</Window>
