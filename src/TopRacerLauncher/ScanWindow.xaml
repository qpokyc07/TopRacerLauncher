<Window x:Class="TopRacerLauncher.ScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TopRacerLauncher"
        Title="TopRacerLauncher — Поиск игр"
        Width="760" Height="640"
        MinWidth="600" MinHeight="460"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgWindowBrush}"
        FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="74"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Text="Найденные игры — выберите нужные" FontWeight="Bold" FontSize="15"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Steam • Epic • GOG • ярлыки" FontSize="12" Margin="12,2,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                        Width="40" Height="34" Style="{StaticResource BaseButton}"
                        Click="Cancel_Click" Content="&#x2715;" FontSize="12" WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <!-- Тело -->
        <Grid Grid.Row="1" Margin="22,16,22,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Фильтр -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="Поиск по названию — введите текст, чтобы отфильтровать список"
                           Style="{StaticResource H2Text}" Margin="0,0,0,7"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FilterBox" Grid.Column="0" Style="{StaticResource BaseTextBox}" Height="40"
                             FontSize="14" Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                             MaxLength="80" TextChanged="Filter_Changed"/>
                    <Button Grid.Column="2" x:Name="RescanButton" Content="Сканировать заново" Height="40" MinWidth="170"
                            Style="{StaticResource BaseButton}" Click="Rescan_Click"/>
                </Grid>
            </StackPanel>

            <!-- Статус -->
            <Grid Grid.Row="1" Margin="0,12,0,8">
                <TextBlock x:Name="StatusText" Text="Сканирую установленные игры…"
                           Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                <ProgressBar x:Name="Progress" Height="4" VerticalAlignment="Bottom"
                             IsIndeterminate="True" Value="0" Maximum="100"/>
            </Grid>

            <!-- Список найденного -->
            <Border Grid.Row="2" Background="#141419" CornerRadius="5"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="GamesItems" Margin="12,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DataTemplate.Resources>
                                    <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
                                </DataTemplate.Resources>
                                <Border CornerRadius="4" Padding="8,7" Margin="0,0,4,4"
                                        Background="{DynamicResource BgCardBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        Cursor="Hand" MouseLeftButtonUp="Item_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Чекбокс (стилизованный вручную) -->
                                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="3"
                                                VerticalAlignment="Center"
                                                Background="#101014"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Path Data="M 3,9 L 7.5,13.5 L 15,5" Stretch="Uniform"
                                                  Stroke="White" StrokeThickness="2.4"
                                                  Visibility="{Binding IsChecked, Converter={StaticResource BoolToVis}}"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="{Binding Path}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <Border Grid.Column="2" CornerRadius="3" Padding="7,3"
                                                Background="#2A2A31" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Source}" FontSize="10.5"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Пусто -->
            <TextBlock x:Name="EmptyText" Grid.Row="2" Text="Ничего не найдено"
                       Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>

        <!-- Нижние кнопки -->
        <Border Grid.Row="2" Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="22,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SelectAllButton" Content="Выбрать все" Height="42" Padding="16,0"
                            Style="{StaticResource BaseButton}" Click="SelectAll_Click"/>
                    <Button x:Name="SelectNoneButton" Content="Снять все" Height="42" Padding="16,0" Margin="10,0,0,0"
                            Style="{StaticResource BaseButton}" Click="SelectNone_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="AddButton" Content="Добавить выбранные" Height="42" Padding="18,0"
                            FontSize="14" Style="{StaticResource PrimaryButton}" Click="Add_Click"/>
                    <Button Content="Отмена" Height="42" Padding="18,0" Margin="10,0,0,0"
                            Style="{StaticResource BaseButton}" Click="Cancel_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
