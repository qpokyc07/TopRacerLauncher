<Window x:Class="TopRacerLauncher.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TopRacerLauncher — что нового"
        Width="700" Height="720" MinWidth="560" MinHeight="460"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgWindowBrush}"
        FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="7"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="TR" FontWeight="Bold" FontSize="10" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Что нового" FontWeight="Bold" FontSize="15"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <Border Background="#18FFFFFF" CornerRadius="8" Padding="8,2" Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="CurrentVersionText" Text="" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                </StackPanel>

                <Button Width="36" Height="32" Style="{StaticResource CaptionButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="Close_Click" Content="&#x2715;" FontSize="11"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <ScrollViewer x:Name="EntriesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Padding="18,14,12,18">
            <StackPanel x:Name="EntriesPanel"/>
        </ScrollViewer>
    </Grid>
</Window>
