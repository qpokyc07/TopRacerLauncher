<Window x:Class="TopRacerLauncher.AchievementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TopRacerLauncher — Достижения"
        Width="1000" Height="740"
        MinWidth="780" MinHeight="560"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgWindowBrush}"
        FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                            VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Width="26" Height="26" CornerRadius="6" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="&#x1F3C6;" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Достижения" FontWeight="Bold" FontSize="15"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <Border Background="#18FFFFFF" CornerRadius="9" Padding="8,2" Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="CounterText" Text="0 из 20" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                </StackPanel>

                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                        Width="40" Height="34" Style="{StaticResource BaseButton}"
                        Click="Close_Click" Content="&#x2715;" FontSize="12"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <!-- Сводка -->
        <Border Grid.Row="1" Style="{StaticResource PanelCard}" Margin="18,16,18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Наиграно" Style="{StaticResource SecondaryText}"/>
                    <TextBlock x:Name="HoursText" Text="0 мин" FontSize="19" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Игр в библиотеке" Style="{StaticResource SecondaryText}"/>
                    <TextBlock x:Name="LibraryText" Text="0" FontSize="19" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Серия дней" Style="{StaticResource SecondaryText}"/>
                    <TextBlock x:Name="StreakText" Text="0" FontSize="19" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Grid>
                        <TextBlock Text="Открыто достижений" Style="{StaticResource SecondaryText}"/>
                        <TextBlock x:Name="PercentText" Text="0%" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <ProgressBar x:Name="TotalProgress" Minimum="0" Maximum="100" Value="0"
                                 Height="7" Margin="0,9,0,0" Style="{StaticResource TimerProgress}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Полка достижений -->
        <ScrollViewer x:Name="Shelf" Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
            <ItemsControl x:Name="ItemsHost" Margin="18,12,18,22">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="300" Margin="0,0,14,14" CornerRadius="14" Padding="16,14"
                                Background="{DynamicResource BgCardBrush}"
                                BorderBrush="{Binding CardBorder}" BorderThickness="1"
                                Opacity="{Binding Opacity}">
                            <StackPanel>
                                <Grid>
                                    <Border Width="42" Height="42" CornerRadius="21" Background="#1AFFFFFF"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Icon}" FontSize="20"
                                                   FontFamily="Segoe UI Emoji"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding DateText}" FontSize="11"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Top"
                                               Visibility="{Binding DateVisibility}" Margin="0,2,0,0"/>
                                    <TextBlock Text="&#x1F512;" FontSize="12" Opacity="0.6"
                                               FontFamily="Segoe UI Emoji"
                                               HorizontalAlignment="Right" VerticalAlignment="Top"
                                               Visibility="{Binding LockVisibility}" Margin="0,2,0,0"/>
                                </Grid>

                                <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" Margin="0,10,0,0"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Text="{Binding Description}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" LineHeight="16" Height="32" Margin="0,4,0,0"/>

                                <ProgressBar Value="{Binding Percent}" Minimum="0" Maximum="100"
                                             Height="6" Margin="0,10,0,0" Style="{StaticResource TimerProgress}"/>

                                <TextBlock Text="{Binding ProgressText}" FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
