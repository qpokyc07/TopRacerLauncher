<Window x:Class="TopRacerLauncher.ControlsSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TopRacerLauncher — Оверлей"
        Width="760" Height="560" ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgWindowBrush}"
        FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="0"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock x:Name="HeaderText" Text="Оверлей" FontWeight="Bold" FontSize="14.5"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0"/>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                        Width="36" Height="32" Style="{StaticResource BaseButton}"
                        Click="Cancel_Click" Content="&#x2715;" FontSize="12"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel Margin="24,16,20,10">
                <TextBlock Text="Нажмите клавиши, которые используются в игре — они подсветятся на оверлее."
                           Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>

                <StackPanel x:Name="KeyboardPanel" Margin="0,14,0,0"/>

                <TextBlock x:Name="PreviewText" Text="" FontSize="12.5" Margin="0,12,0,0"
                           Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>

                <TextBlock Text="Размер и положение" FontSize="12.5" FontWeight="SemiBold" Margin="0,18,0,0"/>
                <WrapPanel Margin="0,8,0,0">
                    <TextBlock Text="Размер" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="ScaleSlider" Width="160" Minimum="60" Maximum="140" Value="100"
                            Style="{StaticResource BaseSlider}" VerticalAlignment="Center"
                            ValueChanged="Scale_Changed"/>
                    <TextBlock x:Name="ScaleLabel" Text="100%" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="8,0,18,0"/>

                    <TextBlock Text="Положение" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="Снизу" Height="28" Padding="12,0" FontSize="11.5" Margin="0,0,6,0"
                            Style="{StaticResource BaseButton}" Tag="bottom" Click="Position_Click"/>
                    <Button Content="Слева" Height="28" Padding="12,0" FontSize="11.5" Margin="0,0,6,0"
                            Style="{StaticResource BaseButton}" Tag="left" Click="Position_Click"/>
                    <Button Content="Справа" Height="28" Padding="12,0" FontSize="11.5"
                            Style="{StaticResource BaseButton}" Tag="right" Click="Position_Click"/>
                </WrapPanel>

                <TextBlock x:Name="HintText" Text="" FontSize="11.5" Margin="0,10,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Очистить" Height="38" Padding="18,0" FontSize="13" Margin="0,0,10,0"
                        Style="{StaticResource BaseButton}" Click="Clear_Click"/>
                <Button Content="Проверить (6 с)" Height="38" Padding="18,0" FontSize="13" Margin="0,0,10,0"
                        Style="{StaticResource BaseButton}" Click="Test_Click"/>
                <Button Content="Сохранить" Height="38" Padding="22,0" FontSize="13.5"
                        Style="{StaticResource PrimaryButton}" Click="Save_Click" IsDefault="True"/>
                <Button Content="Отмена" Height="38" Padding="22,0" FontSize="13.5" Margin="10,0,0,0"
                        Style="{StaticResource BaseButton}" Click="Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
