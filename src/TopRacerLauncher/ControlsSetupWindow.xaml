<Window x:Class="TopRacerLauncher.ControlsSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TopRacerLauncher — Оверлей"
        Width="520" Height="300"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgWindowBrush}"
        FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="0"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock x:Name="HeaderText" Text="Оверлей: клавиши" FontWeight="Bold" FontSize="14.5"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0"/>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                        Width="36" Height="32" Style="{StaticResource BaseButton}"
                        Click="Cancel_Click" Content="&#x2715;" FontSize="12"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="24,18,24,10">
            <TextBlock Text="Какие клавиши подсвечивать в оверлее. Через запятую: W, A, S, D, пробел, ЛКМ, ПКМ."
                       Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
            <TextBox x:Name="KeysBox" Style="{StaticResource BaseTextBox}" Height="40" Margin="0,14,0,0"
                     FontSize="13.5" MaxLength="200"/>
            <TextBlock Text="Подсказка: можно писать целыми наборами — wasd, мышь, пробел, шифт, стрелки. Пусто — подбор по жанру."
                       Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,10,0,0"/>

            <TextBlock x:Name="PreviewText" Text="" FontSize="12.5" Margin="0,12,0,0"
                       Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Сохранить" Height="38" Padding="22,0" FontSize="13.5"
                        Style="{StaticResource PrimaryButton}" Click="Save_Click" IsDefault="True"/>
                <Button Content="Отмена" Height="38" Padding="22,0" FontSize="13.5" Margin="10,0,0,0"
                        Style="{StaticResource BaseButton}" Click="Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
